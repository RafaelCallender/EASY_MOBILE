<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EASYPROJECT01.EASY_MOBILE.VIEW.PAGES.TRANSLATE_VIEW.TRANSLATE_SELECTION_VIEW.Translate_Selection_View01"
             Title="Translate_Selection_View01"
             Shell.NavBarIsVisible="False">
    <ScrollView>
        <StackLayout VerticalOptions="Center"
                     HorizontalOptions="Center">
            <Border x:Name="border01">
                <Image x:Name="image01"/>
            </Border>
            <Border x:Name="border02">
                <Entry x:Name="entry01"></Entry>
            </Border>
            <Label x:Name="label01"></Label>
            <Border x:Name="border03">
                <Picker x:Name="picker01"></Picker>
            </Border>
            <Label x:Name="label02"></Label>
            <Border x:Name="border04">
                <Picker x:Name="picker02"></Picker>
            </Border>
            <Label x:Name="label03"></Label>
            <Border x:Name="border05">
                <!-- TRANSLATION DATA DISPLAY -->

                <CollectionView
                    x:Name="Language_CollectionView01"
                    ItemsSource="{Binding trans}"
                    SelectionMode="None"
                    Margin="10">

                    <CollectionView.ItemTemplate>

                        <DataTemplate>

                            <Border
                                BackgroundColor="#111827"
                                Stroke="#293B52"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 22"
                                Padding="18"
                                Margin="0,0,0,14">

                                <VerticalStackLayout
                                    Spacing="16">


                                    <!-- HEADER -->

                                    <Grid
                                        ColumnDefinitions="Auto,*,Auto"
                                        ColumnSpacing="12">

                                        <Border
                                            BackgroundColor="#263449"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 12"
                                            Padding="10"
                                            VerticalOptions="Center">

                                            <Label
                                                Text="文"
                                                FontSize="22"
                                                TextColor="#A5D8FF"/>

                                        </Border>


                                        <VerticalStackLayout
                                            Grid.Column="1"
                                            Spacing="2"
                                            VerticalOptions="Center">

                                            <Label
                                                Text="Translation Result"
                                                FontSize="18"
                                                FontAttributes="Bold"
                                                TextColor="#F8FAFC"/>

                                            <Label
                                                Text="Language analysis"
                                                FontSize="12"
                                                TextColor="#94A3B8"/>

                                        </VerticalStackLayout>


                                        <Border
                                            Grid.Column="2"
                                            BackgroundColor="#193B32"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 10"
                                            Padding="8,5"
                                            VerticalOptions="Center">

                                            <Label
                                                Text="●"
                                                FontSize="12"
                                                TextColor="#72D5A0"/>

                                        </Border>

                                    </Grid>


                                    <!-- TRANSLATION -->

                                    <Border
                                        BackgroundColor="#1C293B"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 16"
                                        Padding="16">

                                        <VerticalStackLayout
                                            Spacing="10">

                                            <Label
                                                Text="TRANSLATION"
                                                FontSize="11"
                                                FontAttributes="Bold"
                                                TextColor="#94A3B8"/>


                                            <Label
                                                Text="{Binding trans}"
                                                FontSize="20"
                                                FontAttributes="Bold"
                                                TextColor="#F8FAFC"
                                                LineBreakMode="WordWrap"/>


                                            <BoxView
                                                HeightRequest="1"
                                                BackgroundColor="#34445A"/>


                                            <Label
                                                Text="Translated text"
                                                FontSize="12"
                                                TextColor="#94A3B8"/>

                                        </VerticalStackLayout>

                                    </Border>


                                    <!-- LANGUAGE DATA -->

                                    <Grid
                                        ColumnDefinitions="*,*"
                                        ColumnSpacing="10">


                                        <!-- SOURCE LANGUAGE -->

                                        <Border
                                            Grid.Column="0"
                                            BackgroundColor="#1C293B"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 16"
                                            Padding="14">

                                            <VerticalStackLayout
                                                Spacing="8">

                                                <Label
                                                    Text="SOURCE LANGUAGE"
                                                    FontSize="10"
                                                    FontAttributes="Bold"
                                                    TextColor="#94A3B8"/>


                                                <Label
                                                    Text="{Binding source_language}"
                                                    FontSize="17"
                                                    FontAttributes="Bold"
                                                    TextColor="#F8FAFC"
                                                    LineBreakMode="WordWrap"/>


                                                <Border
                                                    BackgroundColor="#263449"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 8"
                                                    Padding="7,4"
                                                    HorizontalOptions="Start">

                                                    <Label
                                                        Text="{Binding source_language_code}"
                                                        FontSize="12"
                                                        TextColor="#A5D8FF"/>

                                                </Border>

                                            </VerticalStackLayout>

                                        </Border>


                                        <!-- TRUST LEVEL -->

                                        <Border
                                            Grid.Column="1"
                                            BackgroundColor="#1C293B"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 16"
                                            Padding="14">

                                            <VerticalStackLayout
                                                Spacing="8">

                                                <Label
                                                    Text="TRUST LEVEL"
                                                    FontSize="10"
                                                    FontAttributes="Bold"
                                                    TextColor="#94A3B8"/>


                                                <Label
                                                    Text="{Binding trust_level}"
                                                    FontSize="25"
                                                    FontAttributes="Bold"
                                                    TextColor="#72D5A0"/>


                                                <Label
                                                    Text="Confidence score"
                                                    FontSize="12"
                                                    TextColor="#94A3B8"/>

                                            </VerticalStackLayout>

                                        </Border>

                                    </Grid>

                                </VerticalStackLayout>

                            </Border>

                        </DataTemplate>

                    </CollectionView.ItemTemplate>

                </CollectionView>
            </Border>
            <Button x:Name="button01"></Button>
            <Button x:Name="button02"></Button>
        </StackLayout>
    </ScrollView>
</ContentPage>