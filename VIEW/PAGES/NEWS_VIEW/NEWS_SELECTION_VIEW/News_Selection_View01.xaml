<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EASYPROJECT01.EASY_MOBILE.VIEW.PAGES.NEWS_VIEW.NEWS_SELECTION_VIEW.News_Selection_View01"
             Title="News_Selection_View01"
             Shell.NavBarIsVisible="False">
    <ScrollView>
        <StackLayout VerticalOptions="Center"
                     HorizontalOptions="Center">
            <Border x:Name="border01">
                <Image x:Name="image01"/>
            </Border>
            <Border x:Name="border02">
                <Entry x:Name="entry01"></Entry>
            </Border>
            <Label x:Name="label01"></Label>
            <Border x:Name="border03">
                <Picker x:Name="picker01"></Picker>
            </Border>
            <Label x:Name="label02"></Label>
            <Border x:Name="border04">
                <CollectionView x:Name="newsCollectionView01"
                                SelectionMode="None"
                                Margin="10,10,10,20">

                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical"
                                           ItemSpacing="12"/>
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Stroke="#E0E0E0"
                                    StrokeThickness="1"
                                    BackgroundColor="White"
                                    StrokeShape="RoundRectangle 15"
                                    Padding="0"
                                    VerticalOptions="Start"
                                    HorizontalOptions="Start">

                                <Grid RowDefinitions="180,Auto,Auto,Auto"
                                      Padding="0">

                                    <!-- News image -->
                                    <Image Grid.Row="0"
                                           Source="{Binding PhotoUrl}"
                                           Aspect="AspectFill"
                                           HeightRequest="180"/>

                                    <!-- News title -->
                                    <Label Grid.Row="1"
                                           Text="{Binding Title}"
                                           FontSize="19"
                                           FontAttributes="Bold"
                                           TextColor="#202020"
                                           LineBreakMode="TailTruncation"
                                           MaxLines="2"
                                           Margin="15,12,15,5"/>

                                    <!-- Source + date -->
                                    <Grid Grid.Row="2"
                                          ColumnDefinitions="*,Auto"
                                          Margin="15,5,15,0">

                                        <Label Grid.Column="0"
                                               Text="{Binding SourceName}"
                                               FontSize="13"
                                               FontAttributes="Bold"
                                               TextColor="#1976D2"/>

                                        <Label Grid.Column="1"
                                               Text="{Binding PublishedDateUtc}"
                                               FontSize="12"
                                               TextColor="#777777"
                                               HorizontalTextAlignment="Start"/>

                                    </Grid>

                                    <!-- Description -->
                                    <Label Grid.Row="3"
                                           Text="{Binding Snippet}"
                                           FontSize="14"
                                           TextColor="#555555"
                                           LineBreakMode="TailTruncation"
                                           MaxLines="3"
                                           Margin="15,8,15,15"/>

                                </Grid>

                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                </CollectionView>


            </Border>
            <Border x:Name="border05">
                <Grid RowDefinitions="Auto,*">

                    <!-- ========================= -->
                    <!-- HEADER -->
                    <!-- ========================= -->

                    <Grid Grid.Row="0"
                          Padding="20,18"
                          BackgroundColor="#FFFFFF"
                          ColumnDefinitions="*,Auto">

                        <VerticalStackLayout Grid.Column="0"
                                             Spacing="2">

                            <Label Text="Latest News"
                                   FontSize="26"
                                   FontAttributes="Bold"
                                   TextColor="#111827"/>

                            <Label Text="Stay informed with the latest stories"
                                   FontSize="13"
                                   TextColor="#6B7280"/>

                        </VerticalStackLayout>

                        <Border Grid.Column="1"
                                WidthRequest="42"
                                HeightRequest="42"
                                StrokeThickness="0"
                                BackgroundColor="#EEF2FF"
                                StrokeShape="RoundRectangle 21">

                            <Label Text="◉"
                                   FontSize="20"
                                   TextColor="#4F46E5"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>

                        </Border>

                    </Grid>


                    <!-- ========================= -->
                    <!-- NEWS LIST -->
                    <!-- ========================= -->

                    <CollectionView Grid.Row="1"
                                    x:Name="newsCollectionView02"
                                    ItemsSource="{Binding NewsItems}"
                                    SelectionMode="Single"
        
                                    Margin="15,15,15,20">

                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical"
                                               ItemSpacing="16"/>
                        </CollectionView.ItemsLayout>


                        <CollectionView.ItemTemplate>

                            <DataTemplate>

                                <Border BackgroundColor="White"
                                        Stroke="#E5E7EB"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 20"
                                        Padding="0">

                                    <VerticalStackLayout Spacing="0">


                                        <!-- ========================= -->
                                        <!-- IMAGE -->
                                        <!-- ========================= -->

                                        <Grid HeightRequest="210">

                                            <Image Source="{Binding Photo_url}"
                                                   Aspect="AspectFill"
                                                   HeightRequest="210"/>

                                            <!-- Image overlay -->

                                            <BoxView BackgroundColor="#40000000"/>

                                            <!-- Source badge -->

                                            <Border HorizontalOptions="Start"
                                                    VerticalOptions="Start"
                                                    Margin="14"
                                                    Padding="9,5"
                                                    BackgroundColor="#DDFFFFFF"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 12">

                                                <HorizontalStackLayout Spacing="6">

                                                    <Image Source="{Binding Source_favicon_url}"
                                                           WidthRequest="16"
                                                           HeightRequest="16"/>

                                                    <Label Text="{Binding Source_name}"
                                                           FontSize="12"
                                                           FontAttributes="Bold"
                                                           TextColor="#111827"
                                                           VerticalOptions="Center"/>

                                                </HorizontalStackLayout>

                                            </Border>


                                            <!-- Story ID -->

                                            <Border HorizontalOptions="End"
                                                    VerticalOptions="Start"
                                                    Margin="14"
                                                    Padding="8,5"
                                                    BackgroundColor="#AA111827"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 10">

                                                <Label Text="{Binding Story_id}"
                                                       FontSize="10"
                                                       TextColor="White"/>

                                            </Border>

                                        </Grid>


                                        <!-- ========================= -->
                                        <!-- CONTENT -->
                                        <!-- ========================= -->

                                        <VerticalStackLayout Padding="17"
                                                             Spacing="11">


                                            <!-- Title -->

                                            <Label Text="{Binding Title}"
                                                   FontSize="21"
                                                   FontAttributes="Bold"
                                                   TextColor="#111827"
                                                   LineBreakMode="WordWrap"
                                                   MaxLines="3"/>


                                            <!-- Date + Author -->

                                            <Grid ColumnDefinitions="Auto,*,Auto"
                                                  ColumnSpacing="8">

                                                <Label Grid.Column="0"
                                                       Text="●"
                                                       FontSize="10"
                                                       TextColor="#4F46E5"
                                                       VerticalOptions="Center"/>

                                                <Label Grid.Column="1"
                                                       Text="{Binding Authors}"
                                                       FontSize="12"
                                                       TextColor="#6B7280"
                                                       LineBreakMode="TailTruncation"
                                                       VerticalOptions="Center"/>

                                                <Label Grid.Column="2"
                                                       Text="{Binding Published_datetime_utc, StringFormat='{0:MMM dd, yyyy HH:mm}'}"
                                                       FontSize="11"
                                                       TextColor="#9CA3AF"
                                                       HorizontalTextAlignment="End"
                                                       VerticalOptions="Center"/>

                                            </Grid>


                                            <!-- Divider -->

                                            <BoxView HeightRequest="1"
                                                     BackgroundColor="#EEF0F3"/>


                                            <!-- Snippet -->

                                            <Label Text="{Binding Snippet}"
                                                   FontSize="14"
                                                   TextColor="#4B5563"
                                                   LineHeight="1.25"
                                                   MaxLines="4"
                                                   LineBreakMode="TailTruncation"/>


                                            <!-- ========================= -->
                                            <!-- TOPICS -->
                                            <!-- ========================= -->

                                            <Label Text="Topics"
                                                   FontSize="12"
                                                   FontAttributes="Bold"
                                                   TextColor="#374151"
                                                   Margin="0,4,0,0"/>

                                            <FlexLayout BindableLayout.ItemsSource="{Binding Topic_name}"
                                                        Direction="Row"
                                                        Wrap="Wrap"
                                                        AlignItems="Start"
                                                        JustifyContent="Start">

                                                <BindableLayout.ItemTemplate>

                                                    <DataTemplate>

                                                        <Border Margin="0,0,6,6"
                                                                Padding="9,5"
                                                                BackgroundColor="#EEF2FF"
                                                                StrokeThickness="0"
                                                                StrokeShape="RoundRectangle 12">

                                                            <Label Text="{Binding .}"
                                                                   FontSize="11"
                                                                   TextColor="#4338CA"/>

                                                        </Border>

                                                    </DataTemplate>

                                                </BindableLayout.ItemTemplate>

                                            </FlexLayout>


                                            <!-- ========================= -->
                                            <!-- ARTICLE INFORMATION -->
                                            <!-- ========================= -->

                                            <Grid RowDefinitions="Auto,Auto,Auto"
                                                  ColumnDefinitions="Auto,*"
                                                  ColumnSpacing="10"
                                                  RowSpacing="7"
                                                  Margin="0,4,0,0">


                                                <!-- Status -->

                                                <Label Grid.Row="0"
                                                       Grid.Column="0"
                                                       Text="Status"
                                                       FontSize="11"
                                                       TextColor="#9CA3AF"/>

                                                <Label Grid.Row="0"
                                                       Grid.Column="1"
                                                       Text="{Binding Status}"
                                                       FontSize="11"
                                                       TextColor="#374151"/>


                                                <!-- Request -->

                                                <Label Grid.Row="1"
                                                       Grid.Column="0"
                                                       Text="Request"
                                                       FontSize="11"
                                                       TextColor="#9CA3AF"/>

                                                <Label Grid.Row="1"
                                                       Grid.Column="1"
                                                       Text="{Binding Request_id}"
                                                       FontSize="11"
                                                       TextColor="#374151"
                                                       LineBreakMode="TailTruncation"/>


                                                <!-- Publication -->

                                                <Label Grid.Row="2"
                                                       Grid.Column="0"
                                                       Text="Publication"
                                                       FontSize="11"
                                                       TextColor="#9CA3AF"/>

                                                <Label Grid.Row="2"
                                                       Grid.Column="1"
                                                       Text="{Binding Source_publication_id}"
                                                       FontSize="11"
                                                       TextColor="#374151"/>

                                            </Grid>


                                            <!-- ========================= -->
                                            <!-- URL INFORMATION -->
                                            <!-- ========================= -->

                                            <VerticalStackLayout Spacing="5"
                                                                 Margin="0,5,0,0">

                                                <Label Text="{Binding Link}"
                                                       FontSize="10"
                                                       TextColor="#4F46E5"
                                                       LineBreakMode="TailTruncation"
                                                       MaxLines="1"/>

                                                <Label Text="{Binding Source_url}"
                                                       FontSize="10"
                                                       TextColor="#9CA3AF"
                                                       LineBreakMode="TailTruncation"
                                                       MaxLines="1"/>

                                            </VerticalStackLayout>


                                            <!-- ========================= -->
                                            <!-- BOTTOM ACTION -->
                                            <!-- ========================= -->

                                            <Grid ColumnDefinitions="*,Auto"
                                                  Margin="0,7,0,0">

                                                <Label Grid.Column="0"
                                                       Text="Read full story"
                                                       FontSize="14"
                                                       FontAttributes="Bold"
                                                       TextColor="#4F46E5"
                                                       VerticalOptions="Center"/>

                                                <Border Grid.Column="1"
                                                        WidthRequest="38"
                                                        HeightRequest="38"
                                                        BackgroundColor="#4F46E5"
                                                        StrokeThickness="0"
                                                        StrokeShape="RoundRectangle 19">

                                                    <Label Text="→"
                                                           FontSize="20"
                                                           TextColor="White"
                                                           HorizontalOptions="Center"
                                                           VerticalOptions="Center"/>

                                                </Border>

                                            </Grid>

                                        </VerticalStackLayout>

                                    </VerticalStackLayout>

                                </Border>

                            </DataTemplate>

                        </CollectionView.ItemTemplate>

                    </CollectionView>

                </Grid>
            </Border>
            <Button x:Name="button01"></Button>
            <Button x:Name="button02"></Button>
        </StackLayout>
    </ScrollView>
</ContentPage>