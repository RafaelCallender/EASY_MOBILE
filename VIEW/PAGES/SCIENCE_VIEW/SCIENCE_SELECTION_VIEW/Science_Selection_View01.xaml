<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EASYPROJECT01.EASY_MOBILE.VIEW.PAGES.SCIENCE_VIEW.SCIENCE_SELECTION_VIEW.Science_Selection_View01"
             Title="Science_Selection_View01"
             Shell.NavBarIsVisible="False">
    <ScrollView>
        <StackLayout VerticalOptions="Center"
                     HorizontalOptions="Center">
            <Border x:Name="border01">
                <Image x:Name="image01"/>
            </Border>
            <Border x:Name="border02">
                <Entry x:Name="entry01"></Entry>
            </Border>
            <Label x:Name="label01"></Label>
            <Border x:Name="border03">
                <Picker x:Name="picker01"></Picker>
            </Border>
            <Label x:Name="label02"></Label>
                   <Border x:Name="border04">
                <Picker x:Name="picker02"></Picker>
            </Border>
            <Label x:Name="label03"></Label>

            <!-- Element Details -->
            <Border x:Name="border05"
               Stroke="#4A90E2"
                    StrokeThickness="2"
                    StrokeShape="RoundRectangle 18"
                    BackgroundColor="#F7FAFF"
                    Padding="18"
                    Margin="10,15,10,20">

                <VerticalStackLayout Spacing="12">

                    <!-- Element Header -->
                    <Grid ColumnDefinitions="Auto,*"
                          ColumnSpacing="15">

                        <Border Grid.Column="0"
                                WidthRequest="75"
                                HeightRequest="75"
                                BackgroundColor="#4A90E2"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 16">

                            <Label x:Name="SymbolLabel"
                                   Text="H"
                                   FontSize="32"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center"/>
                        </Border>

                        <VerticalStackLayout Grid.Column="1"
                                             VerticalOptions="Center"
                                             Spacing="3">

                            <Label x:Name="NameLabel"
                                   Text="Hydrogen"
                                   FontSize="22"
                                   FontAttributes="Bold"
                                   TextColor="#172B4D"/>

                            <Label x:Name="AtomicNumberLabel"
                                   Text="Atomic Number 1"
                                   FontSize="14"
                                   TextColor="#607D9B"/>
                        </VerticalStackLayout>

                    </Grid>

                    <!-- Divider -->
                    <BoxView HeightRequest="1"
                             Color="#D9E5F2"
                             Margin="0,5"/>

                    <!-- Details -->
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                          ColumnDefinitions="*,Auto"
                          RowSpacing="10">

                        <Label Grid.Row="0"
                               Text="Element Name"
                               FontSize="15"
                               TextColor="#607D9B"/>

                        <Label Grid.Row="0"
                               Grid.Column="1"
                               x:Name="ElementNameValue"
                               FontSize="15"
                               FontAttributes="Bold"
                               TextColor="#172B4D"/>

                        <Label Grid.Row="1"
                               Text="Symbol"
                               FontSize="15"
                               TextColor="#607D9B"/>

                        <Label Grid.Row="1"
                               Grid.Column="1"
                               x:Name="SymbolValue"
                               FontSize="15"
                               FontAttributes="Bold"
                               TextColor="#172B4D"/>

                        <Label Grid.Row="2"
                               Text="Atomic Number"
                               FontSize="15"
                               TextColor="#607D9B"/>

                        <Label Grid.Row="2"
                               Grid.Column="1"
                               x:Name="AtomicNumberValue"
                               FontSize="15"
                               FontAttributes="Bold"
                               TextColor="#172B4D"/>

                        <Label Grid.Row="3"
                               Text="Atomic Mass"
                               FontSize="15"
                               TextColor="#607D9B"/>

                        <Label Grid.Row="3"
                               Grid.Column="1"
                               x:Name="AtomicMassValue"
                               FontSize="15"
                               FontAttributes="Bold"
                               TextColor="#172B4D"/>

                        <Label Grid.Row="4"
                               Text="Electrons"
                               FontSize="15"
                               TextColor="#607D9B"/>

                        <Label Grid.Row="4"
                               Grid.Column="1"
                               x:Name="ElectronsValue"
                               FontSize="15"
                               FontAttributes="Bold"
                               TextColor="#172B4D"/>

                        <Label Grid.Row="5"
                               Text="Protons"
                               FontSize="15"
                               TextColor="#607D9B"/>

                        <Label Grid.Row="5"
                               Grid.Column="1"
                               x:Name="ProtonsValue"
                               FontSize="15"
                               FontAttributes="Bold"
                               TextColor="#172B4D"/>

                        <Label Grid.Row="6"
                               Text="Neutrons"
                               FontSize="15"
                               TextColor="#607D9B"/>

                        <Label Grid.Row="6"
                               Grid.Column="1"
                               x:Name="NeutronsValue"
                               FontSize="15"
                               FontAttributes="Bold"
                               TextColor="#172B4D"/>

                    </Grid>

                </VerticalStackLayout>
            </Border>
            <Button x:Name="button01"></Button>
            <Button x:Name="button02"></Button>
        </StackLayout>
    </ScrollView>
</ContentPage>